{
  "output_dir": "artifacts/two_stream_demo",
  "model": "yolo11n.pt",
  "device": "auto",
  "confidence_threshold": 0.35,
  "iou_threshold": 0.5,
  "frame_stride": 1,
  "max_frames_per_camera": 120,
  "save_video": true,
  "tracker": "bytetrack.yaml",
  "reid_candidate_threshold": 0.72,
  "reid_top_k": 3,
  "reid_min_box_size": 32,
  "cameras": [
    {
      "id": "aerial_1",
      "source": "data/aerial_crowd_pexels.mp4",
      "zones": [
        {
          "id": "aerial_observation_area",
          "points": [[0, 0], [2159, 0], [2159, 3839], [0, 3839]],
          "occupancy_alert_threshold": 3
        }
      ]
    },
    {
      "id": "cctv_1",
      "source": "data/ground_crowd_pexels.mp4",
      "zones": [
        {
          "id": "cctv_observation_area",
          "points": [[0, 0], [2159, 0], [2159, 3839], [0, 3839]],
          "occupancy_alert_threshold": 3
        }
      ]
    }
  ]
}
